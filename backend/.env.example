# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/niraksh_guardian?schema=public"

# Redis
REDIS_URL=redis://localhost:6379
# Token blacklist fallback policy when Redis check fails: open | closed
TOKEN_BLACKLIST_FAIL_MODE=open

# Security (JWT)
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# AI (Gemini)
GEMINI_API_KEY=your_gemini_api_key

# AWS SES (Email)
SENDER_EMAIL=verify@example.com
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Cloudinary (Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
