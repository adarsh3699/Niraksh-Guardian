generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                   @id @default(uuid())
  email                    String                   @unique
  passwordHash             String?                  @map("password_hash")
  isEmailVerified          Boolean                  @default(false) @map("is_email_verified")
  isActive                 Boolean                  @default(true) @map("is_active")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  lastLogin                DateTime?                @map("last_login")
  gender                   String?
  name                     String?
  languagePreference       String?                  @map("language_preference")
  chats                    Chat[]
  drugInteractionHistory   DrugInteractionHistory[]
  medicineHistory          MedicineHistory[]
  oauthAccounts            OAuthAccount[]
  resetTokens              PasswordResetToken[]
  prescriptionHistory      PrescriptionHistory[]
  refreshTokens            RefreshToken[]
  symptomAnalysisHistories SymptomAnalysisHistory[]
  patientHealthProfile     PatientHealthProfile?
  healthReports            HealthReport[]

  @@map("users")
}

model HealthReport {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  reportUrl        String   @map("report_url")
  publicId         String?  @map("public_id")
  sources          String[] @default([])
  detailedAnalysis String?  @map("detailed_analysis") @db.Text
  executiveSummary String?  @map("executive_summary") @db.Text
  healthTrends     String?  @map("health_trends") @db.Text
  chatSummary      String?  @map("chat_summary") @db.Text
  recommendations  String[] @default([])
  createdAt        DateTime @default(now()) @map("created_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("health_reports")
}

model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Doctor {
  id              String   @id @default(uuid())
  name            String
  specialization  String
  qualification   String?
  experienceYears Int      @map("experience_years")
  consultationFee Int      @map("consultation_fee")
  rating          Float    @default(0)
  city            String
  state           String
  bio             String
  contactInfo     String   @map("contact_info")
  phone           String?
  imageUrl        String?  @map("image_url")
  tags            String[] @default([])
  isAvailable     Boolean  @default(true) @map("is_available")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([specialization])
  @@index([city])
  @@index([state])
  @@index([rating])
  @@index([consultationFee])
  @@map("doctors")
}

model Chat {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  title     String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@map("chats")
}

model Message {
  id        String   @id @default(uuid())
  chatId    String   @map("chat_id")
  role      String
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([createdAt])
  @@map("messages")
}

model MedicineHistory {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  imageUrl       String   @map("image_url")
  medicineName   String?  @map("medicine_name")
  analysisResult Json     @map("analysis_result")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("medicine_history")
}

model PrescriptionHistory {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  imageUrl       String   @map("image_url")
  extractedText  String   @map("extracted_text")
  analysisResult Json     @map("analysis_result")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("prescription_history")
}

model DrugInteractionHistory {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  drugs             String[]
  interactionResult Json     @map("interaction_result")
  createdAt         DateTime @default(now()) @map("created_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("drug_interaction_history")
}

model SymptomAnalysisHistory {
  id                    String   @id @default(uuid())
  userId                String   @map("user_id")
  symptoms              String[]
  imageUrl              String?  @map("image_url")
  predictedConditions   Json     @map("predicted_conditions")
  urgencyLevel          String   @map("urgency_level")
  recommendedSpecialist String   @map("recommended_specialist")
  severity              String?
  reasoning             String?
  homeRemedies          String[] @default([]) @map("home_remedies")
  createdAt             DateTime @default(now()) @map("created_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("symptom_analysis_history")
}

model PatientHealthProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique @map("user_id")
  healthRiskScore       Int      @default(0) @map("health_risk_score")
  bloodGroup            String?  @map("blood_group")
  allergies             String[]
  chronicConditions     String[] @map("chronic_conditions")
  emergencyContactName  String?  @map("emergency_contact_name")
  emergencyContactPhone String?  @map("emergency_contact_phone")
  emergencyContactEmail String?  @map("emergency_contact_email")
  city                  String?
  state                 String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("patient_health_profiles")
}

model DiseaseInfoCache {
  id        String   @id @default(uuid())
  topic     String
  language  String   @default("en")
  response  Json
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@unique([topic, language])
  @@index([expiresAt])
  @@map("disease_info_cache")
}
