generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum DoctorVerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  CANCELLED_BY_PATIENT
  CANCELLED_BY_DOCTOR
  COMPLETED
  NO_SHOW
}

enum ConsultationMode {
  IN_PERSON
  VIDEO
  PHONE
}

enum PatientAccessStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum DoctorPrescriptionStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum ClinicalIntakeStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  EXPIRED
}

enum ClinicalTriageLevel {
  ROUTINE
  URGENT
  EMERGENCY
}

model User {
  id                       String                   @id @default(uuid())
  email                    String                   @unique
  passwordHash             String?                  @map("password_hash")
  role                     UserRole                 @default(PATIENT)
  isEmailVerified          Boolean                  @default(false) @map("is_email_verified")
  isActive                 Boolean                  @default(true) @map("is_active")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  lastLogin                DateTime?                @map("last_login")
  gender                   String?
  name                     String?
  languagePreference       String?                  @map("language_preference")
  chats                    Chat[]
  drugInteractionHistory   DrugInteractionHistory[]
  medicineHistory          MedicineHistory[]
  oauthAccounts            OAuthAccount[]
  resetTokens              PasswordResetToken[]
  prescriptionHistory      PrescriptionHistory[]
  refreshTokens            RefreshToken[]
  symptomAnalysisHistories SymptomAnalysisHistory[]
  labReports               LabReport[]
  patientHealthProfile     PatientHealthProfile?
  healthReports            HealthReport[]
  doctorProfile            DoctorProfile?
  patientAppointments      Appointment[]            @relation("PatientAppointments")
  patientAccessGrants      PatientDoctorAccess[]    @relation("PatientAccessGrants")
  doctorPrescriptions      DoctorPrescription[]
  clinicalIntakes          ClinicalIntakeSession[]
  clinicalTimelineEntries  ClinicalTimelineEntry[]

  @@map("users")
}

model LabReport {
  id             String               @id @default(uuid())
  userId         String               @map("user_id")
  fileUrl        String               @map("file_url")
  filePublicId   String?              @map("file_public_id")
  fileName       String               @map("file_name")
  mimeType       String               @map("mime_type")
  extractedText  String?              @map("extracted_text") @db.Text
  overallSummary String?              @map("overall_summary") @db.Text
  overallRisk    String               @default("low") @map("overall_risk")
  abnormalCount  Int                  @default(0) @map("abnormal_count")
  totalCount     Int                  @default(0) @map("total_count")
  createdAt      DateTime             @default(now()) @map("created_at")
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  components     LabReportComponent[]
  shares         LabReportShare[]

  @@index([userId])
  @@index([createdAt])
  @@map("lab_reports")
}

model LabReportComponent {
  id                 String          @id @default(uuid())
  reportId           String          @map("report_id")
  componentName      String          @map("component_name")
  observedValue      Float?          @map("observed_value")
  observedRaw        String?         @map("observed_raw")
  unit               String?
  referenceMin       Float?          @map("reference_min")
  referenceMax       Float?          @map("reference_max")
  status             String
  effectSummary      String?         @map("effect_summary") @db.Text
  riskTag            String?         @map("risk_tag")
  confidence         Float?
  sourceSnippet      String?         @map("source_snippet") @db.Text
  category           String?
  aiInsight          String?         @map("ai_insight") @db.Text
  urgency            String?
  symptomConnections String[]        @default([]) @map("symptom_connections")
  relatedConditions  Json?           @map("related_conditions")
  trend              Float[]         @default([])
  whatToDoNext       String?         @map("what_to_do_next") @db.Text
  createdAt          DateTime        @default(now()) @map("created_at")
  report             LabReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  notes              LabReportNote[]

  @@index([reportId])
  @@index([status])
  @@index([category])
  @@map("lab_report_components")
}

model LabReportNote {
  id          String             @id @default(uuid())
  componentId String             @map("component_id")
  note        String             @db.Text
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  component   LabReportComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@index([componentId])
  @@map("lab_report_notes")
}

model LabReportShare {
  id        String    @id @default(uuid())
  reportId  String    @map("report_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  report    LabReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([expiresAt])
  @@map("lab_report_shares")
}

model HealthReport {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  reportUrl        String   @map("report_url")
  publicId         String?  @map("public_id")
  sources          String[] @default([])
  detailedAnalysis String?  @map("detailed_analysis") @db.Text
  executiveSummary String?  @map("executive_summary") @db.Text
  healthTrends     String?  @map("health_trends") @db.Text
  chatSummary      String?  @map("chat_summary") @db.Text
  recommendations  String[] @default([])
  createdAt        DateTime @default(now()) @map("created_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("health_reports")
}

model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Doctor {
  id              String         @id @default(uuid())
  name            String
  specialization  String
  qualification   String?
  experienceYears Int            @map("experience_years")
  consultationFee Int            @map("consultation_fee")
  rating          Float          @default(0)
  city            String
  state           String
  bio             String
  contactInfo     String         @map("contact_info")
  phone           String?
  imageUrl        String?        @map("image_url")
  tags            String[]       @default([])
  isAvailable     Boolean        @default(true) @map("is_available")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  doctorProfile   DoctorProfile?
  appointments    Appointment[]

  @@index([specialization])
  @@index([city])
  @@index([state])
  @@index([rating])
  @@index([consultationFee])
  @@map("doctors")
}

model DoctorProfile {
  id                      String                   @id @default(uuid())
  userId                  String                   @unique @map("user_id")
  directoryDoctorId       String?                  @unique @map("directory_doctor_id")
  licenseNumber           String?                  @unique @map("license_number")
  verificationStatus      DoctorVerificationStatus @default(PENDING) @map("verification_status")
  verificationNote        String?                  @map("verification_note") @db.Text
  displayName             String?                  @map("display_name")
  specialization          String?
  qualification           String?
  experienceYears         Int?                     @map("experience_years")
  consultationFee         Int?                     @map("consultation_fee")
  city                    String?
  state                   String?
  bio                     String?                  @db.Text
  contactInfo             String?                  @map("contact_info")
  phone                   String?
  clinicName              String?                  @map("clinic_name")
  clinicAddress           String?                  @map("clinic_address")
  consultationModes       ConsultationMode[]       @default([]) @map("consultation_modes")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  directoryDoctor         Doctor?                  @relation(fields: [directoryDoctorId], references: [id], onDelete: SetNull)
  availability            DoctorAvailability[]
  appointments            Appointment[]
  patientAccessGrants     PatientDoctorAccess[]
  prePrescriptionChecks   PrePrescriptionCheck[]
  prescriptions           DoctorPrescription[]
  reviewedClinicalIntakes ClinicalIntakeSession[]  @relation("ClinicalIntakeReviews")

  @@index([verificationStatus])
  @@map("doctor_profiles")
}

model ClinicalIntakeSession {
  id                        String               @id @default(uuid())
  patientId                 String               @map("patient_id")
  appointmentId             String?              @unique @map("appointment_id")
  status                    ClinicalIntakeStatus @default(DRAFT)
  chiefComplaint            String?              @map("chief_complaint") @db.Text
  hpi                       Json                 @default("{}")
  ros                       Json                 @default("{}")
  medicationNotes           String?              @map("medication_notes") @db.Text
  allergyNotes              String?              @map("allergy_notes") @db.Text
  summaryDraft              String?              @map("summary_draft") @db.Text
  summaryEdited             String?              @map("summary_edited") @db.Text
  triageLevel               ClinicalTriageLevel  @default(ROUTINE) @map("triage_level")
  triageReasons             String[]             @default([]) @map("triage_reasons")
  triageMessage             String?              @map("triage_message") @db.Text
  consentVersion            String?              @map("consent_version")
  consentGrantedAt          DateTime?            @map("consent_granted_at")
  consentRevokedAt          DateTime?            @map("consent_revoked_at")
  expiresAt                 DateTime             @map("expires_at")
  submittedAt               DateTime?            @map("submitted_at")
  reviewedAt                DateTime?            @map("reviewed_at")
  reviewedByDoctorProfileId String?              @map("reviewed_by_doctor_profile_id")
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")
  patient                   User                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment               Appointment?         @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  reviewedByDoctorProfile   DoctorProfile?       @relation("ClinicalIntakeReviews", fields: [reviewedByDoctorProfileId], references: [id], onDelete: SetNull)

  @@index([patientId, status, expiresAt])
  @@index([appointmentId, status])
  @@map("clinical_intake_sessions")
}

model ClinicalTimelineEntry {
  id         String   @id @default(uuid())
  patientId  String   @map("patient_id")
  sourceType String   @map("source_type")
  sourceId   String?  @map("source_id")
  eventDate  DateTime @map("event_date")
  title      String
  summary    String?  @db.Text
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  patient    User     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, eventDate])
  @@index([patientId, sourceType])
  @@map("clinical_timeline_entries")
}

model DoctorAvailability {
  id                  String        @id @default(uuid())
  doctorProfileId     String        @map("doctor_profile_id")
  weekday             Int           @map("weekday")
  startTime           String        @map("start_time")
  endTime             String        @map("end_time")
  slotDurationMinutes Int           @default(30) @map("slot_duration_minutes")
  isActive            Boolean       @default(true) @map("is_active")
  doctorProfile       DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)

  @@unique([doctorProfileId, weekday, startTime, endTime])
  @@index([doctorProfileId, weekday, isActive])
  @@map("doctor_availability")
}

model Appointment {
  id              String                 @id @default(uuid())
  patientId       String                 @map("patient_id")
  doctorId        String                 @map("doctor_id")
  doctorProfileId String                 @map("doctor_profile_id")
  scheduledAt     DateTime               @map("scheduled_at")
  durationMinutes Int                    @default(30) @map("duration_minutes")
  mode            ConsultationMode       @default(IN_PERSON)
  status          AppointmentStatus      @default(REQUESTED)
  reason          String?                @db.Text
  patientNote     String?                @map("patient_note") @db.Text
  doctorNote      String?                @map("doctor_note") @db.Text
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  patient         User                   @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctor          Doctor                 @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  doctorProfile   DoctorProfile          @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)
  accessGrant     PatientDoctorAccess?
  prescription    DoctorPrescription?
  preChecks       PrePrescriptionCheck[]
  clinicalIntake  ClinicalIntakeSession?

  @@index([patientId, scheduledAt])
  @@index([doctorProfileId, scheduledAt])
  @@index([status, scheduledAt])
  @@map("appointments")
}

model PatientDoctorAccess {
  id              String              @id @default(uuid())
  patientId       String              @map("patient_id")
  doctorProfileId String              @map("doctor_profile_id")
  appointmentId   String?             @unique @map("appointment_id")
  status          PatientAccessStatus @default(ACTIVE)
  grantedAt       DateTime            @default(now()) @map("granted_at")
  expiresAt       DateTime            @map("expires_at")
  revokedAt       DateTime?           @map("revoked_at")
  patient         User                @relation("PatientAccessGrants", fields: [patientId], references: [id], onDelete: Cascade)
  doctorProfile   DoctorProfile       @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  appointment     Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([patientId, status, expiresAt])
  @@index([doctorProfileId, status, expiresAt])
  @@map("patient_doctor_access")
}

model PrePrescriptionCheck {
  id                String        @id @default(uuid())
  appointmentId     String?       @map("appointment_id")
  patientId         String        @map("patient_id")
  doctorProfileId   String        @map("doctor_profile_id")
  proposedMedicines String[]      @map("proposed_medicines")
  currentMedicines  String[]      @map("current_medicines")
  interactionResult Json          @map("interaction_result")
  acknowledgedAt    DateTime?     @map("acknowledged_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  appointment       Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  doctorProfile     DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)

  @@index([patientId, createdAt])
  @@index([doctorProfileId, createdAt])
  @@map("pre_prescription_checks")
}

model DoctorPrescription {
  id              String                       @id @default(uuid())
  appointmentId   String                       @unique @map("appointment_id")
  patientId       String                       @map("patient_id")
  doctorProfileId String                       @map("doctor_profile_id")
  diagnosis       String?                      @db.Text
  instructions    String?                      @db.Text
  status          DoctorPrescriptionStatus     @default(DRAFT)
  issuedAt        DateTime?                    @map("issued_at")
  createdAt       DateTime                     @default(now()) @map("created_at")
  updatedAt       DateTime                     @updatedAt @map("updated_at")
  appointment     Appointment                  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient         User                         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorProfile   DoctorProfile                @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)
  medications     DoctorPrescriptionMedicine[]

  @@index([patientId, createdAt])
  @@index([doctorProfileId, createdAt])
  @@map("doctor_prescriptions")
}

model DoctorPrescriptionMedicine {
  id             String             @id @default(uuid())
  prescriptionId String             @map("prescription_id")
  name           String
  dosage         String?
  frequency      String?
  duration       String?
  instructions   String?            @db.Text
  prescription   DoctorPrescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("doctor_prescription_medicines")
}

model Chat {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  title     String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId, updatedAt])
  @@map("chats")
}

model Message {
  id        String   @id @default(uuid())
  chatId    String   @map("chat_id")
  role      String
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@index([chatId])
  @@index([createdAt])
  @@map("messages")
}

model MedicineHistory {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  imageUrl       String   @map("image_url")
  medicineName   String?  @map("medicine_name")
  analysisResult Json     @map("analysis_result")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId])
  @@index([createdAt])
  @@map("medicine_history")
}

model PrescriptionHistory {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  imageUrl       String   @map("image_url")
  extractedText  String   @map("extracted_text")
  analysisResult Json     @map("analysis_result")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId])
  @@index([createdAt])
  @@map("prescription_history")
}

model DrugInteractionHistory {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  drugs             String[]
  interactionResult Json     @map("interaction_result")
  createdAt         DateTime @default(now()) @map("created_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId])
  @@index([createdAt])
  @@map("drug_interaction_history")
}

model SymptomAnalysisHistory {
  id                    String   @id @default(uuid())
  userId                String   @map("user_id")
  symptoms              String[]
  imageUrl              String?  @map("image_url")
  duration              String?
  needMoreInfo          Boolean  @default(false) @map("need_more_info")
  suggestedSymptoms     String[] @default([]) @map("suggested_symptoms")
  followUpMessage       String?  @map("follow_up_message")
  relationship          Json?
  insight               Json?
  predictedConditions   Json     @map("predicted_conditions")
  urgencyLevel          String   @map("urgency_level")
  recommendedSpecialist String   @map("recommended_specialist")
  severity              String?
  reasoning             String?
  homeRemedies          String[] @default([]) @map("home_remedies")
  createdAt             DateTime @default(now()) @map("created_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId])
  @@index([createdAt])
  @@map("symptom_analysis_history")
}

model PatientHealthProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique @map("user_id")
  healthRiskScore       Int      @default(0) @map("health_risk_score")
  bloodGroup            String?  @map("blood_group")
  allergies             String[]
  chronicConditions     String[] @map("chronic_conditions")
  emergencyContactName  String?  @map("emergency_contact_name")
  emergencyContactPhone String?  @map("emergency_contact_phone")
  emergencyContactEmail String?  @map("emergency_contact_email")
  city                  String?
  state                 String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("patient_health_profiles")
}

model DiseaseInfoCache {
  id        String   @id @default(uuid())
  topic     String
  language  String   @default("en")
  response  Json
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@unique([topic, language])
  @@index([expiresAt])
  @@map("disease_info_cache")
}
